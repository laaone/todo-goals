# 이 파일을 .env로 복사하고 값을 채우세요. (.env는 git에 올라가지 않습니다)
# 설정 방법: docs/GITHUB_OAUTH.md

# MongoDB 연결 문자열
MONGODB_URI=
# (선택) DB 이름. 기본값 todo_goals
MONGODB_DB=

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# (선택) 앱의 공개 주소. 비우면 요청이 들어온 주소를 씁니다.
# GitHub OAuth App의 Authorization callback URL은 <APP_URL>/auth/github/callback 이어야 합니다.
APP_URL=
